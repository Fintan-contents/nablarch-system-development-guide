<?xml version="1.0" encoding="UTF-8"?>
<component-configuration
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://tis.co.jp/nablarch/component-configuration"
    xsi:schemaLocation="http://tis.co.jp/nablarch/component-configuration https://nablarch.github.io/schema/component-configuration.xsd">

  <import file="rest-component-configuration.xml"/>
  <import file="override_dev.xml"/>

  <!-- テスティングフレームワークの設定 -->
  <import file="nablarch/test/test-data.xml"/>
  <import file="nablarch/test/test-transaction.xml"/>
  <import file="nablarch/test/rest-request-test.xml"/>

  <!-- YAMLテストデータ用インタープリタ（QuotationTrimmerを除く）
       TODO: nablarch-testing-yaml が default-configuration artifact を提供したら <import> に差し替える -->
  <list name="yamlInterpreters">
    <component-ref name="nullInterpreter"/>
    <component-ref name="dateTimeInterpreter"/>
    <component-ref name="lineSeparatorInterpreter"/>
    <component-ref name="compositeInterpreter"/>
  </list>

  <!-- YamlTestDataParser でtestDataParserを上書き
       注意: RestTestSupport.getSheet() は testDataParser を経由せず .xlsx を直接開くため
       ClientActionTest.xlsx は nablarch-testing-rest の YAML 対応まで削除しないこと（task #5 参照） -->
  <component name="testDataParser" class="nablarch.test.core.reader.YamlTestDataParser">
    <property name="dbInfo" ref="dbInfo"/>
    <property name="interpreters" ref="yamlInterpreters"/>
  </component>

  <component name="restMockHttpRequestBuilder" class="nablarch.fw.web.RestMockHttpRequestBuilder">
    <property name="defaultContentType" value="application/json"/>
    <property name="bodyConverters">
      <list>
        <component class="nablarch.fw.web.JacksonBodyConverter"/>
        <component class="nablarch.fw.web.StringBodyConverter"/>
      </list>
    </property>
  </component>

  <!-- 汎用のDB設定 -->
  <component name="dbInfo" class="nablarch.test.core.db.GenericJdbcDbInfo">
    <property name="dataSource" ref="dataSource"/>
    <property name="schema" value="${nablarch.db.schema}"/>
  </component>

  <!-- テスト用HttpServerにJetty12を定義する -->
  <component name="httpServerFactory" class="nablarch.fw.web.httpserver.HttpServerFactoryJetty12"/>

</component-configuration>

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/checks.schema.json",
  "title": "Checks Knowledge File Schema",
  "description": "Schema for checks category knowledge files",
  "type": "object",
  "required": ["id", "title", "official_doc_urls", "index", "sections"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "official_doc_urls": {
      "$ref": "common.schema.json#/$defs/officialDocUrls"
    },
    "index": {
      "$ref": "common.schema.json#/$defs/index"
    },
    "sections": {
      "type": "object",
      "required": ["overview", "check_items"],
      "properties": {
        "overview": {
          "type": "object"
        },
        "check_items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "category", "explanation", "items"],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1
              },
              "category": {
                "type": "string",
                "minLength": 1
              },
              "explanation": {
                "type": "string"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["type", "description", "nablarch_feature", "nablarch_support", "reference"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": ["根本的解決", "保険的対策", ""]
                    },
                    "description": {
                      "type": "string"
                    },
                    "nablarch_feature": {
                      "type": "string"
                    },
                    "nablarch_support": {
                      "type": "string",
                      "enum": ["〇", "×", "△", ""]
                    },
                    "reference": {
                      "type": "string"
                    },
                    "explanation": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "additionalProperties": false
          },
          "minItems": 1
        }
      }
    }
  },
  "additionalProperties": false
}

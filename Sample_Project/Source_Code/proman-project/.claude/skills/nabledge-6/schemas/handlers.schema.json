{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/handlers.schema.json",
  "title": "Handlers Knowledge File Schema",
  "description": "Schema for features/handlers category knowledge files",
  "type": "object",
  "required": ["id", "title", "official_doc_urls", "index", "sections"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "official_doc_urls": {
      "$ref": "common.schema.json#/$defs/officialDocUrls"
    },
    "index": {
      "$ref": "common.schema.json#/$defs/index"
    },
    "sections": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "overview": {
          "type": "object",
          "required": ["class_name"],
          "properties": {
            "class_name": {
              "type": "string",
              "pattern": "^nablarch\\."
            }
          }
        },
        "properties": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type", "required", "description"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "modules": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/moduleInfo"
              }
            },
            {
              "type": "object",
              "properties": {
                "dependencies": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          ]
        },
        "constraints": {
          "type": "object",
          "properties": {
            "handler_order": {
              "type": "object",
              "properties": {
                "before": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "after": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "reason": {
                  "type": "string"
                }
              }
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}

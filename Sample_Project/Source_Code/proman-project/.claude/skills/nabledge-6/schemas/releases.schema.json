{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/releases.schema.json",
  "title": "Releases Knowledge File Schema",
  "description": "Schema for releases category knowledge files",
  "type": "object",
  "required": ["id", "title", "version", "official_doc_urls", "index", "sections"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^release-"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "official_doc_urls": {
      "$ref": "common.schema.json#/$defs/officialDocUrls"
    },
    "index": {
      "$ref": "common.schema.json#/$defs/index"
    },
    "sections": {
      "type": "object",
      "required": ["overview", "changes"],
      "properties": {
        "overview": {
          "type": "object"
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["no", "category", "type", "title", "description", "module", "impact"],
            "properties": {
              "no": {
                "type": "integer",
                "minimum": 1
              },
              "category": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "enum": ["変更", "不具合", "追加"]
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "module": {
                "type": "string"
              },
              "impact": {
                "type": "string",
                "enum": ["なし", "あり(開発)", "あり(本番)", "あり"]
              },
              "affected_version": {
                "type": "string"
              },
              "impact_detail": {
                "type": "string"
              },
              "reference": {
                "type": "string"
              },
              "jira": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "minItems": 1
        }
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/libraries.schema.json",
  "title": "Libraries Knowledge File Schema",
  "description": "Schema for features/libraries category knowledge files",
  "type": "object",
  "required": ["id", "title", "official_doc_urls", "index", "sections"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "official_doc_urls": {
      "$ref": "common.schema.json#/$defs/officialDocUrls"
    },
    "index": {
      "$ref": "common.schema.json#/$defs/index"
    },
    "sections": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "methods": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "signature", "description"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "signature": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "parameters": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "returns": {
                "type": "string"
              },
              "example": {
                "type": "string"
              }
            }
          }
        },
        "exceptions": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "description"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "type": "object"
            }
          ]
        },
        "properties": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type", "required", "description"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "modules": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/moduleInfo"
              }
            },
            {
              "type": "object",
              "properties": {
                "dependencies": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "statusLine": {
    "type": "command",
    "command": ".claude/statusline.sh"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/notify.sh",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/notify.sh",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "WebFetch",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(telnet *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(ftp *)",
      "Bash(sftp *)",
      "Bash(git clone http*)",
      "Bash(git clone git@*)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf /)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(fdisk *)",
      "Bash(parted *)",
      "Bash(reboot *)",
      "Bash(shutdown *)",
      "Bash(halt *)",
      "Bash(poweroff *)",
      "Bash(init *)",
      "Bash(systemctl *)",
      "Bash(service *)",
      "Bash(chroot *)",
      "Bash(apt *)",
      "Bash(apt-get *)",
      "Bash(yum *)",
      "Bash(dnf *)",
      "Bash(rpm *)",
      "Bash(dpkg *)",
      "Bash(npm install -g *)",
      "Bash(pip install --user *)",
      "Bash(pip install --global *)",
      "Bash(killall *)",
      "Bash(pkill *)",
      "Bash(kill -9 *)",
      "Bash(nmap *)",
      "Bash(ping *)",
      "Bash(traceroute *)",
      "Bash(mount *)",
      "Bash(umount *)",
      "Bash(> /dev/*)",
      "Bash(exec *)",
      "Bash(cd /mnt/*)",
      "Bash(ls /mnt/*)",
      "Bash(cp */mnt/*)",
      "Bash(cp /mnt/*)",
      "Bash(mv */mnt/*)",
      "Bash(mv /mnt/*)",
      "Bash(rm /mnt/*)",
      "Bash(cat /mnt/*)",
      "Bash(find /mnt/*)",
      "Bash(grep */mnt/*)",
      "Bash(tail /mnt/*)",
      "Bash(head /mnt/*)",
      "Bash(touch /mnt/*)",
      "Bash(mkdir /mnt/*)",
      "Bash(chmod /mnt/*)",
      "Bash(chown /mnt/*)",
      "Bash(explorer.exe *)",
      "Bash(cmd.exe *)",
      "Bash(powershell.exe *)",
      "Bash(wsl.exe *)",
      "Bash(wslpath *)",
      "Bash(*.exe *)",
      "Read(/mnt/*)",
      "Edit(/mnt/*)",
      "Write(/mnt/*)"
    ],
    "allow": [
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(mvn *)",
      "Bash(java *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(touch *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(tail *)",
      "Bash(head *)",
      "Bash(wc *)",
      "Bash(jq *)",
      "Bash(echo *)",
      "Bash(pwd)",
      "Bash(cd *)"
    ]
  }
}